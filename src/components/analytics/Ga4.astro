---
import { GA4_MEASUREMENT_ID, ANALYTICS_CONSENT_KEY } from '../../lib/analytics/ga4';
---

<script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_MEASUREMENT_ID}`}></script>
<script is:inline define:vars={{ GA4_MEASUREMENT_ID, ANALYTICS_CONSENT_KEY }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  window.gtag = gtag;
  gtag('js', new Date());

  /* Fail-closed: deny analytics until saved consent or confirmed non-consent region. */
  gtag('consent', 'default', {
    analytics_storage: 'denied',
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    functionality_storage: 'granted',
    security_storage: 'granted',
    wait_for_update: 1500,
  });

  try {
    var savedConsent = localStorage.getItem(ANALYTICS_CONSENT_KEY);
    if (savedConsent === 'granted' || savedConsent === 'denied') {
      gtag('consent', 'update', { analytics_storage: savedConsent });
    }
  } catch (e) {}

  /*
   * Never let GA build a page URL itself: its automatic page_view can include
   * search parameters. Only non-tool pages render this component, and this
   * explicit event carries a path-only location and a path-only referrer.
   */
  function analyticsPath(value) {
    try {
      var url = new URL(value, window.location.origin);
      return url.pathname;
    } catch (e) {
      return '';
    }
  }

  gtag('config', GA4_MEASUREMENT_ID, {
    send_page_view: false,
    allow_google_signals: false,
    allow_ad_personalization_signals: false,
  });

  gtag('event', 'page_view', {
    page_location: window.location.origin + analyticsPath(window.location.href),
    page_path: analyticsPath(window.location.href),
    page_referrer: analyticsPath(document.referrer),
  });
</script>
