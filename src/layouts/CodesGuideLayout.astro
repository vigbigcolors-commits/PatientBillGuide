---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  crumbs?: Crumb[];
  eyebrow?: string;
}

const { title, description, crumbs = [], eyebrow } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <slot name="head" slot="head" />
  <article class="codes-guide">
    <div class="container">
      {crumbs.length > 0 && <Breadcrumbs items={crumbs} />}
      <header class="codes-guide__header">
        {eyebrow && <p class="codes-guide__eyebrow">{eyebrow}</p>}
        <h1>{title}</h1>
        <slot name="summary" />
      </header>
      <div class="codes-guide__grid">
        <div class="codes-guide__main">
          <slot />
        </div>
        <aside class="codes-guide__aside">
          <slot name="sidebar" />
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .codes-guide {
    padding: var(--space-xl) 0 var(--space-3xl);
  }

  .codes-guide__eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin: 0 0 var(--space-sm);
  }

  .codes-guide__header {
    max-width: 42rem;
    margin-bottom: var(--space-xl);
  }

  .codes-guide__header :global(.codes-guide-summary) {
    font-size: 1.05rem;
    color: var(--color-muted);
    margin: var(--space-sm) 0 0;
    line-height: 1.6;
  }

  .codes-guide__grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--space-xl);
    align-items: start;
  }

  @media (max-width: 900px) {
    .codes-guide__grid {
      grid-template-columns: 1fr;
    }
  }

  .codes-guide__main :global(h2) {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    margin: var(--space-2xl) 0 var(--space-md);
    color: var(--color-primary);
  }

  .codes-guide__main :global(h2:first-child) {
    margin-top: 0;
  }

  .codes-guide__main :global(h3) {
    font-size: 1.05rem;
    margin: var(--space-lg) 0 var(--space-sm);
    color: var(--color-primary);
  }

  .codes-guide__main :global(p),
  .codes-guide__main :global(li) {
    line-height: 1.7;
  }

  .codes-guide__main :global(ul) {
    padding-left: 1.25rem;
    margin: 0 0 var(--space-md);
  }

  .codes-guide__main :global(.faq dt) {
    font-weight: 600;
    color: var(--color-primary);
    margin-top: var(--space-md);
  }

  .codes-guide__main :global(.faq dd) {
    margin: var(--space-xs) 0 0;
    color: var(--color-muted);
  }

  .codes-guide__main :global(.compare-table-wrap) {
    overflow-x: auto;
    margin: var(--space-md) 0 var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .codes-guide__main :global(.compare-table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .codes-guide__main :global(.compare-table th),
  .codes-guide__main :global(.compare-table td) {
    padding: var(--space-md) var(--space-lg);
    text-align: left;
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }

  .codes-guide__main :global(.compare-table thead th) {
    background: var(--color-surface);
    font-weight: 700;
    color: var(--color-primary);
  }

  .codes-guide__main :global(.compare-table tbody tr:last-child th),
  .codes-guide__main :global(.compare-table tbody tr:last-child td) {
    border-bottom: none;
  }

  .codes-guide__main :global(.compare-table code) {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-accent);
  }

  .codes-guide__main :global(.code-link-grid) {
    list-style: none;
    padding: 0;
    margin: var(--space-md) 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-sm);
  }

  .codes-guide__main :global(.code-link-grid a) {
    display: block;
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    font-size: 0.9rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .codes-guide__main :global(.code-link-grid a:hover) {
    border-color: #99f6e4;
    box-shadow: var(--shadow-sm);
  }

  .codes-guide__main :global(.code-link-grid .code-num) {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.25rem;
  }

  .codes-guide__main :global(.cta-row) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin: var(--space-lg) 0;
  }
</style>
