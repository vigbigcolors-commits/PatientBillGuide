---
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustStrip from '../components/TrustStrip.astro';
import { site } from '../data/site';
import interLatin400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import jakartaLatin700 from '@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-700-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  showTrustStrip?: boolean;
  /** Absolute or site-relative URL; defaults to current pathname */
  canonicalUrl?: string;
  /** When true, emit noindex,follow (redirect/stub pages) */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  ogType = 'website',
  showTrustStrip = false,
  canonicalUrl,
  noindex = false,
} = Astro.props;

const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonical = canonicalUrl
  ? new URL(canonicalUrl, site.url).href
  : new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('/og-image.svg', site.url).href;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={jakartaLatin700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin400} as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />
  </head>
  <body>
    <Header />
    {showTrustStrip && <TrustStrip />}
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
