---
import ToolLayout from '../../../layouts/ToolLayout.astro';

const fairPriceMedicare = '/tools/fair-price/?tab=medicare';
---
<ToolLayout
  title="Medicare Allowed Lookup"
  description="Medicare lookup has moved to the Fair Price Calculator — same CMS data with a dedicated Part B estimate tab."
  canonicalUrl="/tools/fair-price/"
  noindex={true}
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Tools', href: '/tools/' },
    { label: 'Medicare Lookup' },
  ]}
>
  <Fragment slot="head">
    <meta http-equiv="refresh" content={`0;url=${fairPriceMedicare}`} />
  </Fragment>
  <p>
    Medicare Allowed Lookup is now part of the
    <a href={fairPriceMedicare}><strong>Fair Price Calculator</strong></a> — use the
    <strong>Medicare Part B estimate</strong> tab for CMS allowed amounts and typical coinsurance.
  </p>
  <p><a href={fairPriceMedicare} class="btn btn--primary">Open Medicare Part B tab</a></p>
</ToolLayout>

<script>
  if (typeof window !== 'undefined') {
    window.location.replace('/tools/fair-price/?tab=medicare');
  }
</script>
