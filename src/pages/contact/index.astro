---
import LegalLayout from '../../layouts/LegalLayout.astro';
---

<LegalLayout
  title="Contact"
  description="Contact PatientBillGuide — questions, corrections, and feedback."
  crumbs={[{ label: 'Contact' }]}
>
  <p>
    We welcome methodology questions, content corrections, and feedback about our free billing
    tools. We read every message; we do not provide medical or legal advice by email.
  </p>

  <h2>Email</h2>
  <p>
    <a href="mailto:contact@patientbillguide.com">contact@patientbillguide.com</a>
  </p>
  <ul>
    <li>Corrections to CPT guides, tools, or methodology pages</li>
    <li>Questions about our CMS data sources or price benchmarks</li>
    <li>Partnership or press inquiries</li>
  </ul>

  <h2>Corrections</h2>
  <p>
    For published content errors, email us with the page URL and a short description. We log
    material fixes on our <a href="/corrections/">corrections</a> page when applicable.
  </p>

  <h2>Privacy</h2>
  <p>
    Do not send medical records, insurance cards, or other personal health information. Our tools
    run in your browser — see <a href="/privacy/">Privacy Policy</a>.
  </p>
</LegalLayout>
