---
import CodesGuideLayout from '../../../layouts/CodesGuideLayout.astro';
import AuthorByline from '../../../components/AuthorByline.astro';
import MethodologyFooter from '../../../components/MethodologyFooter.astro';
import Disclaimer from '../../../components/Disclaimer.astro';
import { cptCategoryPages, cptCategorySlugs, getCategoryCodes } from '../../../data/cpt-categories';
import { site } from '../../../data/site';
import { author, getAuthorUrl } from '../../../data/author';
import { faqPageSchema, medicalWebPageSchema, breadcrumbSchema } from '../../../lib/seo/schema';

export function getStaticPaths() {
  return cptCategorySlugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const page = cptCategoryPages[slug!];
if (!page) return Astro.redirect('/codes/');

const codes = getCategoryCodes(page.slug);
const updated = '2026-07-05';
const pageUrl = `/codes/category/${page.slug}/`;
const canonical = new URL(pageUrl, site.url).href;

const schemaGraph = [
  medicalWebPageSchema({
    name: page.title,
    description: page.metaDescription,
    url: canonical,
    dateModified: updated,
    authorName: author.name,
    authorUrl: getAuthorUrl(site.url),
    authorJobTitle: author.jobTitle,
  }),
  faqPageSchema(page.faq),
  breadcrumbSchema(
    [
      { name: 'Home', url: '/' },
      { name: 'CPT Codes', url: '/codes/' },
      { name: page.title.split('—')[0].trim() },
    ],
    site.url,
  ),
];
---

<CodesGuideLayout
  title={page.title}
  description={page.metaDescription}
  eyebrow={page.eyebrow}
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'CPT Codes', href: '/codes/' },
    { label: page.eyebrow },
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  </Fragment>

  <p slot="summary" class="codes-guide-summary">{page.summary}</p>

  <section>
    <h2>What these codes cover</h2>
    {page.intro.map((p) => <p>{p}</p>)}
  </section>

  <section>
    <h2>What patients see on bills</h2>
    <ul>
      {page.whatPatientsSee.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section>
    <h2>What drives cost</h2>
    <ul>
      {page.costDrivers.map((item) => <li>{item}</li>)}
    </ul>
    <p>
      <a href="/methodology/price-benchmarks/">Our price benchmark methodology</a> uses CMS Medicare
      data with an educational 1.5×–2.5× fair range — not a legal cap.
    </p>
  </section>

  <section>
    <h2>Billing tips</h2>
    <ul>
      {page.billingTips.map((item) => <li>{item}</li>)}
    </ul>
    <div class="cta-row">
      <a class="btn btn--primary" href="/tools/fair-price/">Fair Price Calculator</a>
      <a class="btn btn--secondary" href="/tools/bill-auditor/">Bill Auditor</a>
    </div>
  </section>

  {
    page.featuredCompares.length > 0 && (
      <section>
        <h2>Popular comparisons</h2>
        <ul>
          {page.featuredCompares.map((c) => (
            <li>
              <a href={`/codes/compare/${c.slug}/`}>{c.label}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section>
    <h2>CPT guides in this category ({codes.length})</h2>
    {
      codes.length > 0 ? (
        <ul class="code-link-grid">
          {codes.map((item) => (
            <li>
              <a href={item.href}>
                <span class="code-num">{item.code}</span>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p>
          More guides in this category are being added. Fair Price supports 7,700+ Medicare codes
          in the meantime — <a href="/tools/fair-price/">check any code + ZIP</a>.
        </p>
      )
    }
  </section>

  <section>
    <h2>FAQ</h2>
    <dl class="faq">
      {
        page.faq.map((item) => (
          <>
            <dt>{item.question}</dt>
            <dd>{item.answer}</dd>
          </>
        ))
      }
    </dl>
  </section>

  <AuthorByline variant="written" updated={updated} class="cpt-byline" />
  <Disclaimer />

  <div slot="sidebar">
    <div class="widget-card card">
      <h2>All categories</h2>
      <ul class="sidebar-cats">
        {
          cptCategorySlugs.map((s) => (
            <li>
              {s === page.slug ? (
                <strong>{cptCategoryPages[s].eyebrow}</strong>
              ) : (
                <a href={`/codes/category/${s}/`}>{cptCategoryPages[s].eyebrow}</a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="sidebar-links card">
      <h2>Learn more</h2>
      <ul>
        <li><a href="/learn/cpt-codes-explained/">What is a CPT code?</a></li>
        <li><a href="/learn/how-to-read-medical-bill/">How to read a medical bill</a></li>
        <li><a href="/codes/">Full CPT index</a></li>
      </ul>
    </div>
    <MethodologyFooter />
  </div>
</CodesGuideLayout>

<style>
  .cpt-byline {
    margin-top: var(--space-2xl);
  }

  .widget-card h2,
  .sidebar-links h2 {
    font-size: 1rem;
    margin: 0 0 var(--space-sm);
  }

  .sidebar-cats,
  .sidebar-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.9rem;
  }

  .sidebar-cats li + li,
  .sidebar-links li + li {
    margin-top: var(--space-sm);
  }
</style>
